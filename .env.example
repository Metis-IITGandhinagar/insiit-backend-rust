POSTGRES_URL="postgres://insiit:insiit@db:5432/insiit"
# This service account also sends the push notifications, so it needs the
# Firebase Cloud Messaging API enabled and permission to send messages.
GOOGLE_APPLICATION_CREDENTIALS="./service_account.json"
GOOGLE_CLOUD_PROJECT="<your-firebase-project-name>"
PORT=3700
IMAGE_DIRECTORY="./images"
POSTGRES_USER="insiit"
POSTGRES_PASSWORD="insiit"
POSTGRES_DB="insiit"
# Cabshare GPS check-in point leaving campus, and its radius in metres.
# Optional: defaults to the IITGN point 23.210934, 72.683313 and 150 m.
# CABSHARE_CHECKIN_LAT=23.210934
# CABSHARE_CHECKIN_LNG=72.683313
# CABSHARE_CHECKIN_RADIUS_M=150
